{
  "name": "pokemax",
  "private": true,
  "version": "0.3.7",
  "type": "module",
  "engines": {
    "node": ">=26.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsgo -b --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "system-check": "bun run --sequential format:check typecheck lint test build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "wouter": "3.10.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/ui": "4.1.10",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "lefthook": "2.1.16",
    "node-html-parser": "9.0.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
